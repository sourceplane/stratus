{
  "Messaging": {
    "EventHubsNamespace": "@@wiring(messaging-plane/stage:EVENTHUBS_NAMESPACE)@@",
    "ServiceBusNamespace": "@@wiring(messaging-plane/stage:SERVICEBUS_NAMESPACE)@@",
    "EventHubName": "stage.stratus.events",
    "CommandQueueName": "stage.notifier.commands",
    "ConsumerGroup": "stage.projector"
  },
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/v1/users/{**catch-all}"
        }
      },
      "tenancy": {
        "ClusterId": "tenancy",
        "Match": {
          "Path": "/v1/tenants/{**catch-all}"
        }
      },
      "billing": {
        "ClusterId": "billing",
        "Match": {
          "Path": "/v1/billing/{**catch-all}"
        }
      },
      "identity-docs": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/docs/identity/{**catch-all}"
        }
      },
      "identity-openapi": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/openapi/identity.json"
        }
      },
      "tenancy-docs": {
        "ClusterId": "tenancy",
        "Match": {
          "Path": "/docs/tenancy/{**catch-all}"
        }
      },
      "tenancy-openapi": {
        "ClusterId": "tenancy",
        "Match": {
          "Path": "/openapi/tenancy.json"
        }
      },
      "billing-docs": {
        "ClusterId": "billing",
        "Match": {
          "Path": "/docs/billing/{**catch-all}"
        }
      },
      "billing-openapi": {
        "ClusterId": "billing",
        "Match": {
          "Path": "/openapi/billing.json"
        }
      },
      "notifier-docs": {
        "ClusterId": "notifier",
        "Match": {
          "Path": "/docs/notifier/{**catch-all}"
        }
      },
      "notifier-openapi": {
        "ClusterId": "notifier",
        "Match": {
          "Path": "/openapi/notifier.json"
        }
      },
      "projector-docs": {
        "ClusterId": "projector",
        "Match": {
          "Path": "/docs/projector/{**catch-all}"
        }
      },
      "projector-openapi": {
        "ClusterId": "projector",
        "Match": {
          "Path": "/openapi/projector.json"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "http://stratus-identity-stage/"
          }
        }
      },
      "tenancy": {
        "Destinations": {
          "primary": {
            "Address": "http://stratus-tenancy-stage/"
          }
        }
      },
      "billing": {
        "Destinations": {
          "primary": {
            "Address": "http://stratus-billing-stage/"
          }
        }
      },
      "notifier": {
        "Destinations": {
          "primary": {
            "Address": "http://stratus-notifier-stage/"
          }
        }
      },
      "projector": {
        "Destinations": {
          "primary": {
            "Address": "http://stratus-projector-stage/"
          }
        }
      }
    }
  }
}
