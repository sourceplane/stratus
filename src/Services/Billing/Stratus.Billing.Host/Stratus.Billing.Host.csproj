<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Stratus.Billing.Host</RootNamespace>
    <AssemblyName>Stratus.Billing.Host</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Stratus.Billing.Web/Stratus.Billing.Web.csproj" />
    <ProjectReference Include="../Stratus.Billing.Infrastructure/Stratus.Billing.Infrastructure.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/Stratus.ServiceDefaults/Stratus.ServiceDefaults.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Design-time only, and required HERE rather than only on
         Infrastructure: `dotnet ef` resolves its services from the STARTUP
         project, and this package is marked PrivateAssets=all downstream so
         it does not flow in from the project reference. Without it the
         ef-migrate bundle step cannot build a migration at all. It ships no
         runtime asset, so the container is unchanged. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
