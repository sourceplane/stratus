<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Stratus.Tenancy.Host</RootNamespace>
    <AssemblyName>Stratus.Tenancy.Host</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Stratus.Tenancy.Web/Stratus.Tenancy.Web.csproj" />
    <ProjectReference Include="../Stratus.Tenancy.Infrastructure/Stratus.Tenancy.Infrastructure.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/Stratus.ServiceDefaults/Stratus.ServiceDefaults.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Design-time only, and required HERE rather than only on
         Infrastructure: `dotnet ef` resolves its services from the STARTUP
         project, and this package is marked PrivateAssets=all downstream so
         it does not flow in from the project reference. Without it the
         ef-migrate bundle step cannot build a migration at all. It ships no
         runtime asset, so the container is unchanged. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
