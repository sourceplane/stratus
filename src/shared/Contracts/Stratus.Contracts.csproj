<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Stratus.Contracts</RootNamespace>
    <AssemblyName>Stratus.Contracts</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- The persistence model lives here beside the wire contracts so one
         project defines the shared shape of the system. It takes no PROJECT
         dependencies — the architecture test pins that. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
