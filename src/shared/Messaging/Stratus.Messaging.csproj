<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Stratus.Messaging</RootNamespace>
    <AssemblyName>Stratus.Messaging</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Contracts/Stratus.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Native SDKs, no broker framework. Event Hubs is reached over its
         Kafka wire-protocol endpoint and Service Bus over AMQP 1.0, so the
         programming model is Kafka's and RabbitMQ's without a licence or an
         abstraction that flattens the difference between them. -->
    <PackageReference Include="Azure.Messaging.EventHubs" />
    <PackageReference Include="Azure.Messaging.ServiceBus" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>
</Project>
